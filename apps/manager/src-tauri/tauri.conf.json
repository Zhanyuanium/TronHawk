{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TronHawk Manager",
  "version": "0.1.1",
  "identifier": "com.tronhawk.manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "TronHawk Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tronhawk-core",
      "binaries/tronhawk-injector-launcher"
    ],
    "resources": {
      "binaries/tronhawk_injector.dll": "",
      "binaries/bootstrap.js": "",
      "binaries/runtime.js": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
